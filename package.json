{
  "name": "sea-pos",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Sea POS - Sistema gestionale per ristorante con sincronizzazione cloud multi-dispositivo (Firebase) e APK Android installabile",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
