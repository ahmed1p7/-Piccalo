    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/merge.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
