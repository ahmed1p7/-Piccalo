# ═══════════════════════════════════════════════════════════════════════════════
# 🔥 Sea POS - Firebase Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# احصل على هذه القيم من Firebase Console:
# 1. اذهب إلى: https://console.firebase.google.com/
# 2. أنشئ مشروع جديد: "Sea POS"
# 3. أضف Web App (</>) واحصل على config
# 4. انسخ القيم هنا
#
# ═══════════════════════════════════════════════════════════════════════════════

# Firebase Web Config (من Project Settings → General → Web Apps)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="sea-pos.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sea-pos-xxxxx"
VITE_FIREBASE_STORAGE_BUCKET="sea-pos-xxxxx.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:xxxxxxxxxxxxxxxxxxxxxxx"

# 📌 ملاحظات:
# - هذه القيم آمنة للنشر (ليست سرية)
# - كل جهاز يحتاج نفس القيم
# - ضعها في .env (وليس .env.local) ليتم بناؤها في APK
