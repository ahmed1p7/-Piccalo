# Firebase Web Config (من Project Settings → General → Web Apps)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="sea-restaurant.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sea-restaurant"
VITE_FIREBASE_STORAGE_BUCKET="sea-restaurant.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="737505408693"
VITE_FIREBASE_APP_ID="1:737505408693:android:1059cf4222e84abed0f0fc"

# 💡 Puoi generare il codice di sincronizzazione direttamente da questo file:
#    node scripts/make-sync-code.mjs .env
#
# 💡 Per verificare che il progetto Firebase sia pronto:
#    node scripts/check-firebase.mjs

