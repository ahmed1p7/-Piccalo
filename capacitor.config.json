{
  "appId": "com.sea.pos",
  "appName": "Sea POS",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0f0f0f",
      "showSpinner": false
    },
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "css"
    }
  }
}
